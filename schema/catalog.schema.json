{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://process-manager.local/schema/catalog.schema.json",
  "title": "Catalog",
  "description": "Shared lists that processes and standards pick from: application tiers, environments, programming languages, teams, practices, platforms, categories and tools.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tiers",
    "environments",
    "languages",
    "teams",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tiers": {
      "type": "array",
      "description": "Application tiers, most critical first.",
      "items": {
        "$ref": "#/$defs/tier"
      }
    },
    "environments": {
      "type": "array",
      "description": "Environments, in the order work moves through them.",
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "languages": {
      "type": "array",
      "description": "Programming languages a process can be specific to.",
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "teams": {
      "type": "array",
      "description": "Teams: groups of people that own processes and standards or take part in processes.",
      "items": {
        "$ref": "#/$defs/team"
      }
    },
    "practices": {
      "type": "array",
      "description": "Practices: disciplines such as cyber security or engineering that agree how work is done. Processes and standards can belong to one. Managed separately from teams.",
      "items": {
        "$ref": "#/$defs/practice"
      }
    },
    "platforms": {
      "type": "array",
      "description": "Platforms: the things teams build on, such as a cloud, an API gateway or the source control system. Processes and standards can belong to one. Managed separately from teams and practices.",
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "categories": {
      "type": "array",
      "description": "Categories that group processes and standards in the libraries and in search.",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "tools": {
      "type": "array",
      "description": "Systems used in steps.",
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "contact": {
          "type": "string",
          "maxLength": 120,
          "description": "How to reach the team: channel, mailbox, queue."
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "contact": {
          "type": "string",
          "maxLength": 120,
          "description": "How to reach the people behind the practice: channel, mailbox."
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "contact": {
          "type": "string",
          "maxLength": 120,
          "description": "How to reach the people behind the platform: channel, mailbox, queue."
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
