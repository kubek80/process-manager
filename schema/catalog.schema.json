{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://process-manager.local/schema/catalog.schema.json",
  "title": "Catalog",
  "description": "Shared lists that processes and standards pick from: application tiers, paths, environments, programming languages, teams with the pillars, tribes and domains that group them, practices, platforms, categories, tools and architecture patterns.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tiers",
    "environments",
    "languages",
    "teams",
    "tools"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tiers": {
      "type": "array",
      "description": "Application tiers, most critical first.",
      "items": {
        "$ref": "#/$defs/tier"
      }
    },
    "paths": {
      "type": "array",
      "description": "Paths a process or standard can be for: greenfield (something new is built), brownfield (something that already exists is changed or moved), paved path (the ready-made, supported way, also called the golden path), and any an organisation adds.",
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "environments": {
      "type": "array",
      "description": "Environments, in the order work moves through them.",
      "items": {
        "$ref": "#/$defs/environment"
      }
    },
    "languages": {
      "type": "array",
      "description": "Programming languages a process can be specific to.",
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "teams": {
      "type": "array",
      "description": "Teams: groups of people that own processes and standards or take part in processes.",
      "items": {
        "$ref": "#/$defs/team"
      }
    },
    "pillars": {
      "type": "array",
      "description": "Pillars: groups of teams. A team may name the pillar it is part of; a pillar may name the tribe it is part of. All optional: a pillar without teams or without a tribe is fine. Empty or left out, teams are not grouped.",
      "items": {
        "$ref": "#/$defs/pillar"
      }
    },
    "tribes": {
      "type": "array",
      "description": "Tribes: groups of pillars. A pillar may name the tribe it is part of; a tribe may name the domain it is part of. All optional: a tribe without pillars or without a domain is fine. Empty or left out, pillars are not grouped.",
      "items": {
        "$ref": "#/$defs/tribe"
      }
    },
    "domains": {
      "type": "array",
      "description": "Domains: groups of tribes. A tribe may name the domain it is part of; a domain without tribes is fine. Empty or left out, tribes are not grouped.",
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "practices": {
      "type": "array",
      "description": "Practices: disciplines such as cyber security or engineering that agree how work is done. Processes and standards can belong to one. Managed separately from teams.",
      "items": {
        "$ref": "#/$defs/practice"
      }
    },
    "platforms": {
      "type": "array",
      "description": "Platforms: the things teams build on, such as a cloud, an API gateway or the source control system. Processes and standards can belong to one. Managed separately from teams and practices.",
      "items": {
        "$ref": "#/$defs/platform"
      }
    },
    "categories": {
      "type": "array",
      "description": "Categories that group processes and standards in the libraries and in search.",
      "items": {
        "$ref": "#/$defs/category"
      }
    },
    "tools": {
      "type": "array",
      "description": "Systems used in steps.",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "patterns": {
      "type": "array",
      "description": "Architecture patterns: ways systems are built, such as microservices or event-driven. Processes and standards are tagged with the patterns they are about. An organisation names its own; empty or left out, nothing is tagged.",
      "items": {
        "$ref": "#/$defs/pattern"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "alsoCalled": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "description": "Other names people use for this path, e.g. [\"golden path\"] for the paved path: searching for one of them finds what is for this path. At most 5, each written once."
        },
        "symbol": {
          "enum": [
            "sprout",
            "buildings",
            "road",
            "trail",
            "bridge",
            "flask",
            "rocket",
            "sunset"
          ],
          "description": "The picture that marks this path: sprout (a field with a sprout: something new), buildings (existing buildings: something that is there already), road (a paved road: the ready-made way), trail (a trail of one's own), bridge (moving across), flask (an experiment), rocket (a fast start), sunset (winding down). Leave out for a neutral mark."
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "alsoCalled": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "\\S"
          },
          "description": "Other names people use for this pattern, e.g. [\"event-based\", \"EDA\"] for event-driven: searching for one of them finds what is tagged with this pattern. At most 5, each written once."
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "contact": {
          "type": "string",
          "maxLength": 120,
          "description": "How to reach the team: channel, mailbox, queue."
        },
        "contacts": {
          "$ref": "#/$defs/contacts"
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "pillar": {
          "$ref": "#/$defs/slug",
          "description": "Id of the pillar (from the pillars list) this team is part of. Leave out when it is part of none."
        }
      }
    },
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "tribe": {
          "$ref": "#/$defs/slug",
          "description": "Id of the tribe (from the tribes list) this pillar is part of. Leave out when it is part of none."
        },
        "description": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "tribe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "domain": {
          "$ref": "#/$defs/slug",
          "description": "Id of the domain (from the domains list) this tribe is part of. Leave out when it is part of none."
        },
        "description": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "contact": {
          "type": "string",
          "maxLength": 120,
          "description": "How to reach the people behind the practice: channel, mailbox."
        },
        "contacts": {
          "$ref": "#/$defs/contacts"
        },
        "description": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "contact": {
          "type": "string",
          "maxLength": 120,
          "description": "How to reach the people behind the platform: channel, mailbox, queue."
        },
        "contacts": {
          "$ref": "#/$defs/contacts"
        },
        "description": {
          "type": "string",
          "maxLength": 600
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Id of a square image shown next to the name. It is the fingerprint the portal gives an image when it is uploaded in Admin, Lists; in files, the image itself lies in catalog/icons/ under that id."
        },
        "url": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Id of a square image shown next to the name. It is the fingerprint the portal gives an image when it is uploaded in Admin, Lists; in files, the image itself lies in catalog/icons/ under that id."
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "How to reach them, each way on its own. Every link starts with http:// or https://. Leave the object out when nothing is given.",
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "maxLength": 120,
          "description": "Group email address."
        },
        "slack": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Slack channel name, e.g. #cloud-platform."
        },
        "slackUrl": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "maxLength": 300,
          "description": "Link to that Slack channel."
        },
        "chat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Google Chat space name."
        },
        "chatUrl": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "maxLength": 300,
          "description": "Link to that Google Chat space."
        },
        "confluence": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "maxLength": 300,
          "description": "Link to their Confluence page."
        },
        "page": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "maxLength": 300,
          "description": "Link to their own page or site."
        },
        "form": {
          "type": "string",
          "pattern": "^https?://\\S+$",
          "maxLength": 300,
          "description": "Link to the form where people ask them for something."
        }
      }
    }
  }
}
