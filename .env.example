# Settings of the server. `npm run dev` sets what local development needs; this file documents
# what a deployment has to provide. See docs/backend.md.

# --- always
DATABASE_URL=postgres://user:password@host:5432/process_manager?sslmode=require
PM_BASE_URL=https://processes.example.com        # public address; the sign-in redirect is <this>/auth/callback
PM_SESSION_SECRET=                               # long and random, e.g. the output of: openssl rand -base64 48
PM_ADMINS=first.admin@example.com,second.admin@example.com   # always admin; they give everyone else their roles

# --- sign-in: choose one
PM_AUTH=entra                                    # or: google   (dev is for local development only)
PM_OIDC_CLIENT_ID=
PM_OIDC_CLIENT_SECRET=
PM_ENTRA_TENANT=                                 # Entra ID: your tenant id or domain
PM_GOOGLE_HOSTED_DOMAIN=                         # Google: your Workspace domain. Required with google unless the next line is set
# PM_ALLOWED_EMAIL_DOMAINS=example.com,example.org   # only addresses of these domains may sign in (any provider)

# --- optional
# PM_NOTIFY=webhook                              # default: log
# PM_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# PM_ADDR=0.0.0.0:8080
# PM_LOG_FORMAT=json                             # default: text
# PM_SEED_DIR=/app/seed                          # sample content for an empty database, and schema/

# --- search by meaning (off by default). See docs/backend.md, "Search by meaning".
# Needs the pgvector extension in the database: CREATE EXTENSION IF NOT EXISTS vector;
# builtin: computed in the server, nothing leaves it.
# vertex:  the text of published processes and standards and every search query is sent to
#          Google Cloud (Vertex AI). Credentials come from Application Default Credentials
#          (workload identity, or GOOGLE_APPLICATION_CREDENTIALS) - never put a key here.
# PM_EMBEDDINGS=off                              # off, builtin or vertex
# PM_EMBEDDINGS_MODEL=gemini-embedding-001       # vertex only
# PM_EMBEDDINGS_DIMENSIONS=768
# PM_VERTEX_PROJECT=                             # vertex only: the Google Cloud project
# PM_VERTEX_LOCATION=                            # vertex only: the region, e.g. europe-west4
# PM_CHUNK_PARTS=summary,step,prerequisite,requirement,scope
# PM_CHUNK_MAX_CHARS=2000
