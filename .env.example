# Settings of the server. `npm run dev` sets what local development needs; this file documents
# what a deployment has to provide. See docs/backend.md.

# --- always
DATABASE_URL=postgres://user:password@host:5432/process_manager?sslmode=require
PM_BASE_URL=https://processes.example.com        # public address; the sign-in redirect is <this>/auth/callback
PM_SESSION_SECRET=change-me-to-32-or-more-random-characters
PM_ADMINS=first.admin@example.com,second.admin@example.com   # always admin; they give everyone else their roles

# --- sign-in: choose one
PM_AUTH=entra                                    # or: google   (dev is for local development only)
PM_OIDC_CLIENT_ID=
PM_OIDC_CLIENT_SECRET=
PM_ENTRA_TENANT=                                 # Entra ID: your tenant id or domain
# PM_GOOGLE_HOSTED_DOMAIN=example.com            # Google: only accounts of this Workspace domain

# --- optional
# PM_NOTIFY=webhook                              # default: log
# PM_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# PM_ADDR=0.0.0.0:8080
# PM_SEED_DIR=/app/seed                          # sample content for an empty database, and schema/
